---
interface Props {
  name: string;
  slug: string;
  shortDesc: string;
  icon: string;
}
const { name, slug, shortDesc, icon } = Astro.props;
---

<a href={`/tools/${slug}`} class="group flex flex-col gap-3 p-6 bg-white rounded-xl border border-slate-200 hover:border-blue-300 hover:shadow-md transition-all">
  <div class="text-3xl">{icon}</div>
  <div>
    <div class="font-semibold text-slate-900 group-hover:text-blue-600 transition-colors">{name}</div>
    <div class="text-sm text-slate-500 mt-1 leading-relaxed">{shortDesc}</div>
  </div>
  <div class="text-sm font-medium text-blue-600 mt-auto">Try free →</div>
</a>
